# Copia este archivo como .env.local y completa con los datos reales.
# Supabase > Project Settings > API > anon public

# ── Proyecto CMDB (base de datos de activos) ──────────────────────────────
VITE_SUPABASE_URL=https://TU-PROYECTO-CMDB.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-public-key-cmdb

# ── Proyecto DCSM (autenticación compartida con ITSM y horas-extra) ───────
# La sesión la maneja este cliente (sbDcsm), no el de CMDB.
VITE_DCSM_SUPABASE_URL=https://TU-PROYECTO-DCSM.supabase.co
VITE_DCSM_SUPABASE_ANON_KEY=tu-anon-public-key-dcsm
